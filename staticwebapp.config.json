{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/team/*",
      "/game/*",
      "/data/*",
      "/images/*.{png,jpg,gif}",
      "/css/*",
      "/js/*",
      "/*.{ico,svg,woff,woff2,ttf,eot,js,json}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ]
}
