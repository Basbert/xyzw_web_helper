{
  "name": "xyzw-token-manager",
  "version": "2.0.0",
  "type": "module",
  "description": "XYZW游戏Token管理器 - 支持Base64导入和WebSocket连接管理",
  "main": "src/main.js",
  "scripts": {
    "testr": "node ./test/roleToken.js",
    "testd": "node ./test/token.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src render-backend edge-functions test public/heartbeat-worker.js public/game/multi-game-storage-bridge.js public/game/diagnose_require.js vite.config.js worker.js eslint.config.mjs uno.config.ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,vue,css,scss,json}\" \"render-backend/**/*.{js,json}\" \"edge-functions/**/*.js\" \"test/**/*.{js,mjs}\" \"*.{js,mjs,ts,json,html}\" \"public/heartbeat-worker.js\" \"public/game/{index.html,multi-game.html,multi-game-storage-bridge.js,diagnose_require.js}\"",
    "lint:fix": "eslint src render-backend edge-functions test public/heartbeat-worker.js public/game/multi-game-storage-bridge.js public/game/diagnose_require.js vite.config.js worker.js eslint.config.mjs uno.config.ts --max-warnings 0 --fix",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,vue,css,scss,json}\" \"render-backend/**/*.{js,json}\" \"edge-functions/**/*.js\" \"test/**/*.{js,mjs}\" \"*.{js,mjs,ts,json,html}\" \"public/heartbeat-worker.js\" \"public/game/{index.html,multi-game.html,multi-game-storage-bridge.js,diagnose_require.js}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "@vicons/material": "^0.12.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.21.1",
    "crypto-js": "^4.2.0",
    "event-emitter3": "^1.0.4",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lz4js": "^0.2.0",
    "naive-ui": "^2.43.1",
    "p-queue": "^7.4.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.19",
    "vue-router": "^4.6.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@iconify-json/mdi": "^1.2.3",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.19.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "prettier": "^3.9.9",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "unocss": "^0.61.9",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.4.1",
    "unplugin-vue-router": "^0.8.8",
    "vite": "^5.4.11"
  },
  "keywords": [
    "vue",
    "token-management",
    "websocket",
    "base64",
    "game-automation",
    "xyzw",
    "frontend"
  ],
  "author": "XYZW Team",
  "license": "CC-BY-NC-SA-4.0",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "lodash-es": "4.18.1"
    }
  },
  "packageManager": "pnpm@10.19.0"
}
